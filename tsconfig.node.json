{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "lib": ["ES2022"],
        "skipLibCheck": true,
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,
        "strict": true,
        "types": ["node", "vitest/globals"]
    },
    "include": ["vite.config.ts", "vitest.config.ts", "scripts", "tests", "playwright.config.ts"]
}
